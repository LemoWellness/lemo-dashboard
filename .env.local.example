# ---- Firebase CLIENT config (safe to expose to the browser) ----
# Firebase console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push certificate (Firebase console > Project settings > Cloud Messaging > Web Push certificates)
# Public key only. Required for Phase 2 device registration. Does not send messages by itself.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---- Firebase ADMIN config (server-only, NEVER exposed to the browser) ----
# Firebase console > Project settings > Service accounts > Generate new private key
# Paste the full JSON contents as ONE line (escape newlines as \\n) or base64-encode it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Calendar (optional, only needed once Tasks module is ported)
# A service account with domain-wide delegation, or an OAuth refresh token.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Task notifications (Phase 1 in-app + daily cron)
# Set the same CRON_SECRET in Vercel. Vercel Cron sends Authorization: Bearer CRON_SECRET.
CRON_SECRET=
# Days before deadline to send Due Soon. Default 1 if unset.
TASK_DUE_SOON_DAYS=1
